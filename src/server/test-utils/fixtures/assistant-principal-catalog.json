    "admittedFunctionBodies": [
      {
        "schema": "auth",
        "function": "auth.uid()",
        "definition": "CREATE OR REPLACE FUNCTION auth.uid()\n RETURNS uuid\n LANGUAGE sql\n STABLE\nAS $function$\n  select \n  coalesce(\n    nullif(current_setting('request.jwt.claim.sub', true), ''),\n    (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub')\n  )::uuid\n$function$\n",
        "prosecdef": false,
        "proconfig": null,
        "acl": "{=X/supabase_auth_admin,supabase_auth_admin=X/supabase_auth_admin,dashboard_user=X/supabase_auth_admin}"
      },
      {
        "schema": "public",
        "function": "handle_new_auth_user()",
        "definition": "CREATE OR REPLACE FUNCTION public.handle_new_auth_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nbegin\n  if new.email is null then\n    return new;\n  end if;\n  insert into public.profiles (id, email, display_name)\n  values (\n    new.id,\n    new.email,\n    coalesce(\n      nullif(new.raw_user_meta_data->>'full_name', ''),\n      nullif(new.raw_user_meta_data->>'name', ''),\n      split_part(new.email, '@', 1)\n    )\n  )\n  on conflict (id) do nothing;\n  return new;\nend;\n$function$\n",
        "prosecdef": true,
        "proconfig": ["search_path=public"],
        "acl": "{postgres=X/postgres,service_role=X/postgres}"
      }
    ]
