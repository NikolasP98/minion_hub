[Unit]
Description=Independent JEV shadow heartbeat and weekly report generation
[Service]
Type=oneshot
User=jev-shadow
Group=jev-shadow
WorkingDirectory=/opt/minion-jev-shadow/current
Environment=JEV_SHADOW_DATA=/var/lib/minion-jev-shadow
ExecStart=/usr/bin/node /opt/minion-jev-shadow/current/worker.mjs report
TimeoutStartSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minion-jev-shadow
[Install]
WantedBy=multi-user.target
