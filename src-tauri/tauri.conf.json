{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minion Hub",
  "version": "0.0.1",
  "identifier": "app.minionhub.desktop",
  "build": {
    "frontendDist": "https://hub.minion-ai.org"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Minion Hub desktop",
    "longDescription": "Native desktop shell for the hosted Minion Hub. No bundled server.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["minion"]
      }
    }
  }
}
