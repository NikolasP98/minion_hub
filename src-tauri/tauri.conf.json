{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minion Hub",
  "version": "0.0.2",
  "identifier": "app.minionhub.desktop",
  "build": {
    "frontendDist": "../desktop-dist",
    "beforeBuildCommand": "bun run desktop:ui",
    "beforeDevCommand": "bun run desktop:ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Minion Hub desktop",
    "longDescription": "Native desktop shell for the hosted Minion Hub. No bundled server.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/main.desktop"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "minion"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2NDE2RTRBQzJFRDk0NTEKUldSUmxPM0NTbTVCQm8xd2VkZGE2VGpXd3VZeVZKR2dyODlSd21WY0ZyMjdYT3lGRE9pM3p5QU0K",
      "endpoints": [
        "https://github.com/NikolasP98/minion_hub/releases/download/desktop-updates/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
